# Neon / Postgres (required on Vercel)
DATABASE_URL=postgres://USER:PASS@HOST/dbname?sslmode=require

# Per-game write keys. Games send: Authorization: Bearer <key>
# These are not anti-cheat — static games will ship the key in the client.
HALL_GAME_KEYS={"gemfall":"replace-me","tetris":"replace-me"}

# Optional. Set on hall.moopit.fun so every *.moopit.fun game shares one cipher.
COOKIE_DOMAIN=.moopit.fun

# Extra browser origins allowed to read/post (comma-separated). *.moopit.fun is already allowed.
# HALL_EXTRA_ORIGINS=https://gemfall-of-the-moopit.vercel.app
